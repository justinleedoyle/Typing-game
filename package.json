{
  "name": "portalwrights-almanac",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx tests/run.ts",
    "desktop:typecheck": "tsc --noEmit -p tsconfig.desktop.json",
    "desktop:build": "npm run typecheck && npm run desktop:typecheck && node scripts/build-desktop.mjs",
    "desktop:start": "npm run desktop:build && npm run desktop:runtime && electron .",
    "desktop:pack": "npm run desktop:build && electron-builder --dir",
    "desktop:win": "npm run desktop:build && electron-builder --win zip --x64",
    "desktop:runtime": "node node_modules/electron/install.js"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.105.4",
    "phaser": "^3.87.0"
  },
  "devDependencies": {
    "@types/node": "24.19.2",
    "electron": "45.1.0",
    "electron-builder": "26.18.0",
    "tsx": "4.23.15",
    "typescript": "^5.7.0",
    "vite": "^6.0.0"
  },
  "main": "desktop-dist/main.cjs",
  "description": "A storybook typing adventure through five remembered realms.",
  "author": "Justin Doyle",
  "engines": {
    "node": ">=22.12.0"
  }
}
